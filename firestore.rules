rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/projects/{projectId} {
      function owner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasAll(['name','payload','revision','deleted','updatedAt'])
          && d.keys().hasOnly(['name','payload','revision','deleted','updatedAt'])
          && d.name is string && d.name.size() <= 500
          && d.payload is string && d.payload.size() <= 850000
          && d.revision is int && d.deleted is bool
          && d.updatedAt == request.time;
      }
      allow read: if owner();
      allow create: if owner() && valid()
        && request.resource.data.revision == 1 && request.resource.data.deleted == false;
      allow update: if owner() && valid() && resource.data.deleted == false
        && request.resource.data.revision == resource.data.revision + 1
        && (!request.resource.data.deleted || request.resource.data.payload == '{}');
      // Use revisioned tombstones, not physical deletes, to prevent old devices restoring deleted data.
      allow delete: if false;
    }
  }
}
